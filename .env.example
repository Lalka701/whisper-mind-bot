TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Оставьте пустым для локального запуска (polling).
# Для Koyeb вставьте URL вашего приложения (без слэша в конце).
WEBHOOK_URL=https://your-app-name.koyeb.app

# Koyeb автоматически устанавливает PORT=8000 — менять не нужно.
PORT=8000
